---
layout: base.njk
---
{# A getting-started guide, laid out like a manual: the hero, then a section
   nav beside the prose, then the project cards from the `projects` frontmatter.
   The nav is built from the guide's own ## and ### headings by the
   `guideSections` filter in .eleventy.js, which also gives each one an id and
   a `#` link. It renders twice: a sticky sidebar on wide screens and a folded
   "On this page" block on narrow ones; CSS shows one or the other. #}
{% set doc = content | guideSections %}

{% macro sectionNav(toc) %}
  <ol class="toc">
    {% for s in toc %}
      <li>
        <a href="#{{ s.id }}">{{ s.text | safe }}</a>
        {% if s.children.length %}
          <ol>
            {% for c in s.children %}
              <li><a href="#{{ c.id }}">{{ c.text | safe }}</a></li>
            {% endfor %}
          </ol>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
{% endmacro %}

<article class="guide-page">
  <p class="back"><a href="/guides/">← Guides</a></p>

  <section class="hero">
    <h1>{{ title }}</h1>
    {% if summary %}<p>{{ summary }}</p>{% endif %}
  </section>

  <div class="guide-layout">
    <aside class="guide-sidebar" aria-label="Guide navigation">
      <nav aria-labelledby="guides-title">
        <p class="sidebar-title" id="guides-title">Guides</p>
        <ul class="toc">
          {% for g in collections.guide %}
            <li><a href="{{ g.url }}"{% if g.url == page.url %} aria-current="page"{% endif %}>{{ g.data.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      {% if doc.toc.length %}
        <nav aria-labelledby="toc-title">
          <p class="sidebar-title" id="toc-title">On this page</p>
          {{ sectionNav(doc.toc) }}
        </nav>
      {% endif %}
    </aside>

    <div class="guide-main">
      {% if doc.toc.length %}
        <details class="toc-mobile">
          <summary>On this page</summary>
          {{ sectionNav(doc.toc) }}
        </details>
      {% endif %}

      <div class="prose">
        {{ doc.html | safe }}
      </div>
    </div>
  </div>

  {% if projects %}
    <h2 class="section-label">Projects in this guide</h2>
    <ul class="project-grid">
      {% for project in collections.project | bySlugs(projects) %}
        {% include "project-card.njk" %}
      {% endfor %}
    </ul>
  {% endif %}
</article>

{# Marks the nav entry for the section in view. Without JS the nav is plain
   links, so nothing depends on this. It waits for DOMContentLoaded because it
   also watches the footer, which comes after <main>. #}
<script>
  const initGuideNav = () => {
    if (!("IntersectionObserver" in window)) return;
    const heads = [...document.querySelectorAll(".guide-page .prose :is(h2, h3)[id]")];
    if (!heads.length) return;
    const links = (id) => document.querySelectorAll(`.toc a[href="#${CSS.escape(id)}"]`);
    let current = null;
    const update = () => {
      // The last heading above a line a quarter of the way down; at the very
      // bottom of the page, the last one on screen, so a short final section
      // can still be reached.
      const atEnd =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      const line = atEnd ? window.innerHeight : window.innerHeight * 0.25;
      let active = heads[0];
      for (const h of heads) {
        if (h.getBoundingClientRect().top <= line) active = h;
        else break;
      }
      if (active === current) return;
      if (current) links(current.id).forEach((a) => a.removeAttribute("aria-current"));
      links(active.id).forEach((a) => a.setAttribute("aria-current", "true"));
      current = active;
    };
    const io = new IntersectionObserver(update, { rootMargin: "0px 0px -75% 0px" });
    heads.forEach((h) => io.observe(h));
    // The footer coming into view is the "reached the end" signal.
    const foot = document.querySelector(".site-footer");
    if (foot) new IntersectionObserver(update, { threshold: [0, 0.5, 0.9, 0.98] }).observe(foot);
    update();
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initGuideNav);
  else initGuideNav();
</script>

{# Renders ```mermaid blocks as diagrams. Mermaid is self-hosted under
   /assets/mermaid/ (passthrough from node_modules, see .eleventy.js) and only
   loaded on a page that has a diagram. The source block stays in the page and
   is hidden once its diagram renders, so without JS, or if a diagram fails to
   parse, the reader still sees the source. Colors come from the theme tokens,
   and diagrams re-render when the color scheme changes. #}
<script type="module">
  const diagrams = [...document.querySelectorAll(".guide-page .prose pre > code.language-mermaid")].map(
    (code) => {
      const pre = code.parentElement;
      const fig = document.createElement("figure");
      fig.className = "diagram";
      fig.hidden = true;
      pre.before(fig);
      return { pre, fig, source: code.textContent };
    },
  );
  if (diagrams.length) {
    const { default: mermaid } = await import("/assets/mermaid/mermaid.esm.min.mjs");
    const scheme = matchMedia("(prefers-color-scheme: dark)");
    let n = 0;
    const render = async () => {
      const css = getComputedStyle(document.documentElement);
      const token = (name) => css.getPropertyValue(name).trim();
      mermaid.initialize({
        startOnLoad: false,
        theme: "base",
        darkMode: scheme.matches,
        fontFamily: token("--font-sans"),
        themeVariables: {
          background: token("--bg"),
          primaryColor: token("--card"),
          primaryTextColor: token("--fg"),
          primaryBorderColor: token("--accent"),
          secondaryColor: token("--bg"),
          tertiaryColor: token("--bg"),
          lineColor: token("--muted"),
          textColor: token("--fg"),
          clusterBkg: token("--bg"),
          clusterBorder: token("--line"),
          edgeLabelBackground: token("--card"),
        },
      });
      for (const d of diagrams) {
        try {
          const { svg } = await mermaid.render(`mermaid-${++n}`, d.source);
          d.fig.innerHTML = svg;
          d.fig.hidden = false;
          d.pre.hidden = true;
        } catch (err) {
          console.warn("mermaid diagram failed to render; showing its source", err);
        }
      }
    };
    await render();
    scheme.addEventListener("change", render);
  }
</script>
